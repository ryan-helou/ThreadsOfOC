# Copy to .env for local dev, or set these as Railway variables in production.

# Owner password used to sign in (write access). Never shipped to the client.
AUTH_PASSWORD=change-me

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. On Railway, point this at a mounted volume.
DB_PATH=./data/threads.db

# Set to "production" in prod so the server serves the built client from dist/.
NODE_ENV=development
